rules_version = '2';

/**
 * Security model, in one sentence: every privileged write (payment status,
 * entry eligibility, winner selection, prizes, terms publication, roles) is
 * authorized ENTIRELY by the rules below — there is no Cloud Functions layer
 * behind these rules on this project (Spark plan; Cloud Functions require
 * Blaze and are intentionally not used). These rules ARE the primary
 * authorization boundary, not a backstop.
 *
 * Role checks read `users/{uid}.role`/`isActive` directly (no Auth custom
 * claims — nothing sets those without a Cloud Function). `myRole()` is the
 * single source of truth every isAdmin()/isSuperAdmin() check depends on.
 *
 * Enable Firebase App Check enforcement for Cloud Firestore in the Firebase
 * Console for this project; it is a defense-in-depth layer against
 * unauthorized clients and is not a substitute for the checks below.
 */
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function myProfile() {
      return isSignedIn() ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : null;
    }

    function isActiveUser() {
      return myProfile() != null && myProfile().isActive == true;
    }

    function myRole() {
      return isActiveUser() ? myProfile().role : null;
    }

    function isAdmin() {
      return myRole() == 'admin' || myRole() == 'super_admin';
    }

    function isSuperAdmin() {
      return myRole() == 'super_admin';
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function unchangedExcept(allowedKeys) {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly(allowedKeys);
    }

    // ---------------------------------------------------------------------
    // users
    // ---------------------------------------------------------------------
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();

      // Registration creates this doc client-side; role/isActive are forced
      // to safe defaults here so a client can never self-assign a role.
      allow create: if isOwner(userId)
        && request.resource.data.role == 'participant'
        && request.resource.data.isActive == true
        && request.resource.data.keys().hasAll(['fullName', 'email', 'phoneNumber', 'role', 'isActive', 'createdAt', 'updatedAt']);

      // The owner may update their own non-sensitive contact fields. A
      // super_admin (never themself) may change role/isActive — this is the
      // entire role-management mechanism now; there is no Cloud Function.
      allow update: if (isOwner(userId) && unchangedExcept(['fullName', 'phoneNumber', 'photoURL', 'updatedAt']))
        || (isSuperAdmin() && request.auth.uid != userId && unchangedExcept(['role', 'isActive', 'updatedAt']));

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // raffles
    // ---------------------------------------------------------------------
    match /raffles/{raffleId} {
      // Applies per-candidate-document to both get and list requests: a
      // public list query (which never filters for status == 'DRAFT')
      // only ever has non-draft candidates, so this passes; an admin's
      // unfiltered "all raffles" query passes via isAdmin() regardless.
      allow get, list: if resource.data.status != 'DRAFT' || isAdmin();
      allow create: if isAdmin()
        && request.resource.data.status == 'DRAFT'
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.hasWinner == false
        && request.resource.data.stats.totalRegistrations == 0;

      // Admin branches (A-H) are gated behind a SINGLE isAdmin() call rather
      // than one per branch: empirically, against the live project, having
      // several separate isAdmin()-calling `allow update` branches/statements
      // (even split into fully separate `allow update` statements) caused
      // Firestore to deny the unrelated, isAdmin()-free branch I (the
      // participant registration write) below — reproduced repeatedly via
      // direct writes against the live project. A single isAdmin() call site
      // resolved it. Root cause not confirmed (suspected undocumented
      // per-rule-evaluation cost/limit around repeated get()-calling
      // branches), but this structure is verified reliable.
      allow update: if isAdmin() && (
        // A. Content edits — admin, only while DRAFT/UPCOMING, status itself
        // unchanged in this branch.
        (resource.data.status == request.resource.data.status
          && resource.data.status in ['DRAFT', 'UPCOMING']
          && unchangedExcept([
            'name', 'nameLower', 'slug', 'shortDescription', 'fullDescription',
            'bannerUrl', 'thumbnailUrl',
            'schedule', 'payment', 'eligibility', 'entryConfig', 'updatedAt'
          ]))
        // B. Terms pointer — set by the publishTerms client flow, any status.
        || (resource.data.status == request.resource.data.status
          && unchangedExcept(['activeTermsId', 'activeTermsVersion', 'updatedAt']))
        // C. Publish — DRAFT -> UPCOMING/OPEN/DRAWING (whichever the
        // registration window is already in at publish time), requires a
        // prize to exist. The admin-only UI checklist also requires active
        // terms; this rule adds a server-side backstop for the prize half
        // of that check.
        || (resource.data.status == 'DRAFT'
          && request.resource.data.status in ['UPCOMING', 'OPEN', 'DRAWING']
          && exists(/databases/$(database)/documents/prizes/$(raffleId))
          && unchangedExcept(['status', 'updatedAt']))
        // D. Cancel — any non-terminal status -> CANCELLED.
        || (resource.data.status in ['DRAFT', 'UPCOMING', 'OPEN', 'DRAWING']
          && request.resource.data.status == 'CANCELLED'
          && unchangedExcept(['status', 'updatedAt']))
        // E/F. Lifecycle sweep — no Cloud Scheduler on Spark, so an admin's
        // own browser (useRaffleStatusSweep) performs these once the
        // relevant window has passed, per request.time (server-authoritative).
        || (resource.data.status == 'UPCOMING'
          && request.resource.data.status == 'OPEN'
          && request.time >= resource.data.schedule.registrationStart
          && unchangedExcept(['status', 'updatedAt']))
        || (resource.data.status == 'OPEN'
          && request.resource.data.status == 'DRAWING'
          && request.time >= resource.data.schedule.registrationEnd
          && unchangedExcept(['status', 'updatedAt']))
        // G. Draw completion — DRAWING -> COMPLETED, winner fields + stats.
        || (resource.data.status == 'DRAWING'
          && request.resource.data.status == 'COMPLETED'
          && unchangedExcept(['status', 'hasWinner', 'currentWinnerEntryId', 'stats', 'updatedAt']))
        // H. Admin-triggered stat/winner adjustments with status unchanged —
        // payment review, disqualify, redraw. A payment approval that would
        // push paymentsApproved past the raffle's cap is rejected here too,
        // mirroring branch I's registration-time check — the client-side
        // check in reviewPayment (src/services/payments.ts) is UX only.
        || (resource.data.status == request.resource.data.status
          && unchangedExcept(['stats', 'hasWinner', 'currentWinnerEntryId', 'updatedAt'])
          && (request.resource.data.stats.paymentsApproved <= resource.data.stats.paymentsApproved
            || request.resource.data.stats.paymentsApproved <= resource.data.entryConfig.get('maxParticipants', 999999999)))
      );

      // I. Registration stats bump — participant-triggered, exactly +1 on
      // exactly these two counters, nothing else in stats moves. Blocked
      // once approved participants have reached the raffle's cap.
      allow update: if isSignedIn()
        && resource.data.status == request.resource.data.status
        // .get() with a default avoids denying every registration on
        // raffles created before maxParticipants existed on entryConfig.
        && resource.data.stats.paymentsApproved < resource.data.entryConfig.get('maxParticipants', 999999999)
        && request.resource.data.stats.totalRegistrations == resource.data.stats.totalRegistrations + 1
        && request.resource.data.stats.paymentsPending == resource.data.stats.paymentsPending + 1
        && request.resource.data.stats.paymentsApproved == resource.data.stats.paymentsApproved
        && request.resource.data.stats.paymentsRejected == resource.data.stats.paymentsRejected
        && request.resource.data.stats.eligibleEntries == resource.data.stats.eligibleEntries
        && request.resource.data.stats.disqualifiedEntries == resource.data.stats.disqualifiedEntries
        && unchangedExcept(['stats', 'updatedAt']);

      allow delete: if isAdmin() && resource.data.status == 'DRAFT';

      match /terms/{termsId} {
        allow get, list: if resource.data.status == 'active' || isAdmin();
        allow create: if isAdmin()
          && request.resource.data.status == 'draft'
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.raffleId == raffleId;
        allow update: if isAdmin()
          && ((resource.data.status == 'draft' && request.resource.data.status == 'draft'
              && unchangedExcept(['contentJson', 'contentHtml', 'updatedAt']))
            || (resource.data.status == 'draft' && request.resource.data.status == 'active'
              && unchangedExcept(['status', 'updatedAt']))
            || (resource.data.status == 'active' && request.resource.data.status == 'archived'
              && unchangedExcept(['status', 'updatedAt'])));
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------------
    // prizes — exactly one document per raffle, doc id === raffleId
    // ---------------------------------------------------------------------
    match /prizes/{raffleId} {
      allow get, list: if true;
      allow create: if isAdmin()
        && request.resource.data.raffleId == raffleId
        && request.resource.data.status == 'available';
      allow update: if isAdmin()
        && unchangedExcept([
          'name', 'description', 'imageUrl', 'videoUrl', 'value', 'currency',
          'status', 'claimedAt', 'claimedBy', 'verifiedBy', 'claimNotes',
          'deliveryDate', 'deliveryMethod', 'updatedAt'
        ]);
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // entries
    // ---------------------------------------------------------------------
    match /entries/{entryId} {
      // For `list`, Firestore evaluates this rule against every document
      // the query could possibly return; because the app always queries
      // this collection with a `where('userId','==',uid)` filter for
      // participant reads, every candidate document already satisfies the
      // ownership check below. Admin queries (no userId filter) instead
      // satisfy the isAdmin() branch, which holds for every candidate.
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      // Created by the registering participant, for themself, always in the
      // same starting state — the registration transaction (raffles rule
      // branch I) enforces the rest of the invariants alongside this.
      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'payment_pending'
        && request.resource.data.isEligible == false;

      allow update: if isAdmin()
        && ((resource.data.status == 'payment_pending' && request.resource.data.status in ['eligible', 'rejected']
            && unchangedExcept(['status', 'isEligible', 'updatedAt']))
          || (resource.data.status == 'eligible' && request.resource.data.status == 'disqualified'
            && unchangedExcept(['status', 'isEligible', 'updatedAt']))
          || (resource.data.status == 'eligible' && request.resource.data.status == 'winner'
            && unchangedExcept(['status', 'updatedAt'])));

      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // payments
    // ---------------------------------------------------------------------
    match /payments/{paymentId} {
      allow get, list: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());

      allow create: if isSignedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.status == 'pending';

      allow update: if isAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && unchangedExcept(['status', 'reviewedAt', 'reviewedBy', 'rejectionReason', 'updatedAt']);

      allow delete: if false;
    }

    // Payment-reference uniqueness registry: create-only (fails atomically
    // if the reference is already taken), never read back or mutated.
    match /paymentReferences/{reference} {
      allow get: if isSignedIn();
      allow create: if isSignedIn();
      allow list, update, delete: if false;
    }

    // Per-raffle atomic entry-number sequence.
    match /counters/{raffleId} {
      allow get: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.lastEntrySequence == 1;
      allow update: if isSignedIn()
        && request.resource.data.lastEntrySequence == resource.data.lastEntrySequence + 1;
      allow list, delete: if false;
    }

    // ---------------------------------------------------------------------
    // draws — public read for the live draw screen; admin-only write
    // ---------------------------------------------------------------------
    match /draws/{drawId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
        && unchangedExcept(['presentationState', 'status', 'completedAt', 'failureReason', 'updatedAt']);
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // winners — public read (masked display name only, by design);
    // admin-only write. Disqualification/redraw never delete a record.
    // ---------------------------------------------------------------------
    match /winners/{winnerId} {
      allow get, list: if true;
      allow create: if isAdmin();
      allow update: if isAdmin()
        && unchangedExcept(['status', 'isActive', 'disqualifiedBy', 'disqualifiedAt', 'disqualificationReason', 'updatedAt']);
      allow delete: if false;
    }

    // ---------------------------------------------------------------------
    // auditLogs — append-only, admin-readable, written by whoever performs
    // the action they're logging (self-attested — see AGENTS/plan notes on
    // the trust tradeoff this implies without a Cloud Function backing it).
    // ---------------------------------------------------------------------
    match /auditLogs/{logId} {
      allow get, list: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.actorId == request.auth.uid;
      allow update, delete: if false;
    }
  }
}
